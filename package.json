{
  "name": "cursor-team-plugins",
  "displayName": "Team plugins",
  "description": "Keeps a team's Cursor plugins (rules, skills, commands, agents and MCP servers) in sync with the team's git repositories and registers the ones each user and project selected.",
  "version": "0.8.6",
  "publisher": "mathieugun",
  "author": "Mathieu Gunther",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mathieugun/cursor-team-plugins.git"
  },
  "homepage": "https://github.com/mathieugun/cursor-team-plugins#readme",
  "bugs": {
    "url": "https://github.com/mathieugun/cursor-team-plugins/issues"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "package": "node scripts/package.js"
  },
  "contributes": {
    "configuration": {
      "title": "Team plugins",
      "properties": {
        "teamPlugins.repositories": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "branch": {
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ]
              }
            ]
          },
          "default": [],
          "scope": "application",
          "description": "Team plugin repositories to follow: Git URLs (HTTPS, git@host:path or ssh://) or { \"url\", \"branch\" } objects (no branch: the repository's default branch). Each is cloned with your own git credentials (credential helper or SSH key; in a remote window, the remote machine's); the extension never asks for them: sign in once in a terminal."
        },
        "teamPlugins.localRepositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Your own clones of plugin repositories (for plugin authors): edits are picked up live and the extension never runs a git command that changes them. A clone replaces the repository of teamPlugins.repositories that has the same name. Set per machine: in a remote window, paths on the remote machine."
        },
        "teamPlugins.updateIntervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "scope": "application",
          "description": "How often to check the repositories for updates. 0: only at startup and with \"Sync now\"."
        },
        "teamPlugins.enabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Plugins (`<repository>:<plugin>`) and single items (`<repository>:<plugin>/skills/<folder>`, `/rules/<file>`, `/commands/<file>`, `/agents/<file>`, `/mcp/<server>`) enabled in every project. Edited by the Team Plugins view."
        },
        "teamPlugins.excluded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Items (skills, rules, commands, agents, MCP servers) left out of plugins enabled in `teamPlugins.enabled`. Edited by the view."
        },
        "teamPlugins.projectPlugins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Plugins or single items (`<repository>:<plugin>`, ...) this project needs: enabled for everyone who opens it (commit `.vscode/settings.json`). Read from workspace and folder settings only."
        },
        "teamPlugins.projectRepositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          },
          "default": [],
          "scope": "resource",
          "description": "Where the repositories used by teamPlugins.projectPlugins are: someone who opens the project without following one is offered to add it. Written by \"Add to this project\" (commit .vscode/settings.json). Read from workspace and folder settings only."
        },
        "teamPlugins.repoUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "deprecationMessage": "Replaced by teamPlugins.repositories (moved there automatically).",
          "description": "Git URL of the team plugins repository (HTTPS, git@host:path or ssh://). Cloned with your own git credentials (credential helper or SSH key; in a remote window, the remote machine's); the extension never asks for them: sign in once in a terminal."
        },
        "teamPlugins.branch": {
          "type": "string",
          "default": "",
          "scope": "application",
          "deprecationMessage": "Replaced by teamPlugins.repositories (moved there automatically).",
          "description": "Branch to follow. Empty: the repository's default branch."
        },
        "teamPlugins.localRepoPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "deprecationMessage": "Replaced by teamPlugins.localRepositories (moved there automatically).",
          "description": "Use this existing clone instead of the managed one (for plugin authors): edits are picked up live and the extension never runs a git command that changes it. Set per machine: in a remote window, a path on the remote machine."
        }
      }
    },
    "colors": [
      {
        "id": "teamPlugins.projectItemForeground",
        "description": "Colour of the plugins and items that the project enables (teamPlugins.projectPlugins) in the Team Plugins view.",
        "defaults": {
          "dark": "charts.purple",
          "light": "charts.purple",
          "highContrast": "charts.purple",
          "highContrastLight": "charts.purple"
        }
      },
      {
        "id": "teamPlugins.newItemForeground",
        "description": "Colour of the items added since you last looked, in the Team Plugins view.",
        "defaults": {
          "dark": "gitDecoration.addedResourceForeground",
          "light": "gitDecoration.addedResourceForeground",
          "highContrast": "gitDecoration.addedResourceForeground",
          "highContrastLight": "gitDecoration.addedResourceForeground"
        }
      },
      {
        "id": "teamPlugins.updatedItemForeground",
        "description": "Colour of the items updated since you last looked, in the Team Plugins view.",
        "defaults": {
          "dark": "gitDecoration.modifiedResourceForeground",
          "light": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground",
          "highContrastLight": "gitDecoration.modifiedResourceForeground"
        }
      }
    ],
    "commands": [
      {
        "command": "teamPlugins.syncNow",
        "title": "Sync now",
        "category": "Team Plugins",
        "icon": "$(sync)"
      },
      {
        "command": "teamPlugins.openRepo",
        "title": "Open repository folder",
        "category": "Team Plugins",
        "icon": "$(folder-opened)"
      },
      {
        "command": "teamPlugins.showLog",
        "title": "Show log",
        "category": "Team Plugins",
        "icon": "$(output)"
      },
      {
        "command": "teamPlugins.checkGit",
        "title": "Check git",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.getStarted",
        "title": "Get started",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.addRepository",
        "title": "Add repository",
        "category": "Team Plugins",
        "icon": "$(add)"
      },
      {
        "command": "teamPlugins.addLocalRepository",
        "title": "Add a local clone",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.removeRepository",
        "title": "Remove repository",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.addProjectRepository",
        "title": "Add repository",
        "category": "Team Plugins",
        "icon": "$(add)"
      },
      {
        "command": "teamPlugins.addToProject",
        "title": "Add to this project",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.removeFromProject",
        "title": "Remove from this project",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.openItem",
        "title": "Open file",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.commitAndPush",
        "title": "Commit and push local changes",
        "category": "Team Plugins",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "teamPlugins.pushToBranch",
        "title": "Push local changes to a branch",
        "category": "Team Plugins",
        "icon": "$(git-branch)"
      },
      {
        "command": "teamPlugins.openChange",
        "title": "Open changes",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.discardLocalChanges",
        "title": "Discard local changes in the managed clone",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.openConflict",
        "title": "Compare",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.keepRepositoryVersion",
        "title": "Keep repository version",
        "category": "Team Plugins",
        "icon": "$(arrow-left)"
      },
      {
        "command": "teamPlugins.keepCopyVersion",
        "title": "Keep copy version",
        "category": "Team Plugins",
        "icon": "$(arrow-right)"
      },
      {
        "command": "teamPlugins.newPlugin",
        "title": "New plugin",
        "category": "Team Plugins",
        "icon": "$(new-folder)"
      },
      {
        "command": "teamPlugins.newSkill",
        "title": "New skill",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.newRule",
        "title": "New rule",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.newCommand",
        "title": "New command",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.newAgent",
        "title": "New agent",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.newMcpServer",
        "title": "New MCP server",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.moveDraft",
        "title": "Move to a repository",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.rename",
        "title": "Rename",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.shareWithTeam",
        "title": "Share with team...",
        "category": "Team Plugins"
      },
      {
        "command": "teamPlugins.whatChanged",
        "title": "What changed",
        "category": "Team Plugins",
        "icon": "$(diff)"
      },
      {
        "command": "teamPlugins.showChanges",
        "title": "Show changes",
        "category": "Team Plugins"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "teamPlugins.commitAndPush",
          "when": "view == teamPlugins.plugins && teamPlugins.hasChanges",
          "group": "navigation@0"
        },
        {
          "command": "teamPlugins.syncNow",
          "when": "view == teamPlugins.plugins",
          "group": "navigation@1"
        },
        {
          "command": "teamPlugins.addRepository",
          "when": "view == teamPlugins.plugins",
          "group": "navigation@2"
        },
        {
          "command": "teamPlugins.openRepo",
          "when": "view == teamPlugins.plugins",
          "group": "navigation@3"
        },
        {
          "command": "teamPlugins.showLog",
          "when": "view == teamPlugins.plugins",
          "group": "navigation@4"
        },
        {
          "command": "teamPlugins.newPlugin",
          "when": "view == teamPlugins.plugins",
          "group": "1_author@1"
        },
        {
          "command": "teamPlugins.getStarted",
          "when": "view == teamPlugins.plugins",
          "group": "9_help@1"
        }
      ],
      "view/item/context": [
        {
          "command": "teamPlugins.addToProject",
          "when": "view == teamPlugins.plugins && viewItem =~ /^(plugin|child)$/"
        },
        {
          "command": "teamPlugins.removeFromProject",
          "when": "view == teamPlugins.plugins && viewItem =~ /\\.project$/"
        },
        {
          "command": "teamPlugins.commitAndPush",
          "when": "view == teamPlugins.plugins && viewItem == changes",
          "group": "inline"
        },
        {
          "command": "teamPlugins.commitAndPush",
          "when": "view == teamPlugins.plugins && viewItem == changes",
          "group": "1_changes@1"
        },
        {
          "command": "teamPlugins.pushToBranch",
          "when": "view == teamPlugins.plugins && viewItem == changes",
          "group": "1_changes@2"
        },
        {
          "command": "teamPlugins.discardLocalChanges",
          "when": "view == teamPlugins.plugins && viewItem == changes",
          "group": "1_changes@3"
        },
        {
          "command": "teamPlugins.keepRepositoryVersion",
          "when": "view == teamPlugins.plugins && viewItem == conflict",
          "group": "inline"
        },
        {
          "command": "teamPlugins.keepRepositoryVersion",
          "when": "view == teamPlugins.plugins && viewItem == conflict",
          "group": "1_conflict@1"
        },
        {
          "command": "teamPlugins.keepCopyVersion",
          "when": "view == teamPlugins.plugins && viewItem == conflict",
          "group": "inline"
        },
        {
          "command": "teamPlugins.keepCopyVersion",
          "when": "view == teamPlugins.plugins && viewItem == conflict",
          "group": "1_conflict@2"
        },
        {
          "command": "teamPlugins.whatChanged",
          "when": "view == teamPlugins.plugins && viewItem =~ /^repo\\.(managed|local)$/",
          "group": "0_updates@1"
        },
        {
          "command": "teamPlugins.showChanges",
          "when": "view == teamPlugins.plugins && viewItem =~ /^child(\\.project)?$/",
          "group": "0_updates@1"
        },
        {
          "command": "teamPlugins.openRepo",
          "when": "view == teamPlugins.plugins && viewItem =~ /^repo\\./",
          "group": "1_repo@1"
        },
        {
          "command": "teamPlugins.removeRepository",
          "when": "view == teamPlugins.plugins && viewItem =~ /^repo\\.(managed|local)$/",
          "group": "1_repo@2"
        },
        {
          "command": "teamPlugins.newPlugin",
          "when": "view == teamPlugins.plugins && viewItem =~ /^repo\\.(managed|local|drafts)$/",
          "group": "2_author@1"
        },
        {
          "command": "teamPlugins.moveDraft",
          "when": "view == teamPlugins.plugins && viewItem == plugin.draft",
          "group": "1_draft@1"
        },
        {
          "command": "teamPlugins.rename",
          "when": "view == teamPlugins.plugins && viewItem =~ /^(plugin|child)/",
          "group": "3_edit@1"
        },
        {
          "command": "teamPlugins.newSkill",
          "when": "view == teamPlugins.plugins && viewItem =~ /^plugin/",
          "group": "2_new@1"
        },
        {
          "command": "teamPlugins.newRule",
          "when": "view == teamPlugins.plugins && viewItem =~ /^plugin/",
          "group": "2_new@2"
        },
        {
          "command": "teamPlugins.newCommand",
          "when": "view == teamPlugins.plugins && viewItem =~ /^plugin/",
          "group": "2_new@3"
        },
        {
          "command": "teamPlugins.newAgent",
          "when": "view == teamPlugins.plugins && viewItem =~ /^plugin/",
          "group": "2_new@4"
        },
        {
          "command": "teamPlugins.newMcpServer",
          "when": "view == teamPlugins.plugins && viewItem =~ /^plugin/",
          "group": "2_new@5"
        },
        {
          "command": "teamPlugins.addProjectRepository",
          "when": "view == teamPlugins.plugins && viewItem == missing",
          "group": "inline"
        },
        {
          "command": "teamPlugins.addProjectRepository",
          "when": "view == teamPlugins.plugins && viewItem == missing",
          "group": "1_missing@1"
        }
      ],
      "explorer/context": [
        {
          "command": "teamPlugins.shareWithTeam",
          "when": "explorerResourceIsFolder && resourcePath =~ /[\\\\/]\\.cursor[\\\\/]skills[\\\\/][^\\\\/]+$/ || !explorerResourceIsFolder && resourcePath =~ /[\\\\/]\\.cursor[\\\\/](rules[\\\\/](.+[\\\\/])?[^\\\\/]+\\.mdc?|skills[\\\\/][^\\\\/]+[\\\\/]SKILL\\.md|commands[\\\\/][^\\\\/]+\\.(md|mdc|markdown|txt)|agents[\\\\/][^\\\\/]+\\.(md|mdc|markdown))$/",
          "group": "7_teamPlugins@1"
        }
      ],
      "commandPalette": [
        {
          "command": "teamPlugins.addToProject",
          "when": "false"
        },
        {
          "command": "teamPlugins.removeFromProject",
          "when": "false"
        },
        {
          "command": "teamPlugins.openItem",
          "when": "false"
        },
        {
          "command": "teamPlugins.openChange",
          "when": "false"
        },
        {
          "command": "teamPlugins.openConflict",
          "when": "false"
        },
        {
          "command": "teamPlugins.keepRepositoryVersion",
          "when": "false"
        },
        {
          "command": "teamPlugins.keepCopyVersion",
          "when": "false"
        },
        {
          "command": "teamPlugins.addProjectRepository",
          "when": "false"
        },
        {
          "command": "teamPlugins.rename",
          "when": "false"
        },
        {
          "command": "teamPlugins.showChanges",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "teamPlugins.rename",
        "key": "f2",
        "when": "focusedView == teamPlugins.plugins && !inputFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "teamPlugins",
          "title": "Team Plugins",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "teamPlugins": [
        {
          "id": "teamPlugins.plugins",
          "name": "Plugins"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "teamPlugins.plugins",
        "when": "teamPlugins.state == unconfigured",
        "contents": "No team plugin repository is configured.\n[Add repository](command:teamPlugins.addRepository)\nPlugin authors can use their own clone instead:\n[Add a local clone](command:teamPlugins.addLocalRepository)\nNew here? [Get started](command:teamPlugins.getStarted)"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Team plugins",
        "description": "Follow your team's plugin repositories and pick the rules, skills, commands, agents and MCP servers you need.",
        "steps": [
          {
            "id": "checkGit",
            "title": "Check git",
            "description": "Team plugins clones and updates the team repositories in the background, with your own git and its credentials: git 2.38 or later must reach the repository without asking anything.\n[Check git](command:teamPlugins.checkGit)",
            "media": { "markdown": "resources/walkthrough-git.md" },
            "completionEvents": ["onContext:teamPlugins.gitReady"]
          },
          {
            "id": "addRepository",
            "title": "Add a team repository",
            "description": "Paste the Git URL of your team's plugin repository: it is cloned in the background and checked for updates every hour. You can follow several.\n[Add repository](command:teamPlugins.addRepository)\nPlugin authors can follow their own clone instead: [Add a local clone](command:teamPlugins.addLocalRepository).",
            "media": { "markdown": "resources/walkthrough-repository.md" },
            "completionEvents": ["onSettingChanged:teamPlugins.repositories", "onSettingChanged:teamPlugins.localRepositories"]
          },
          {
            "id": "pickPlugins",
            "title": "Pick your plugins",
            "description": "Tick the plugins you want in the Team Plugins view: the agent uses them in every project, in new chats. Expand a plugin to pick single skills, rules, commands, agents or MCP servers.\n[Open the Team Plugins view](command:workbench.view.extension.teamPlugins)",
            "media": { "markdown": "resources/walkthrough-plugins.md" },
            "completionEvents": ["onSettingChanged:teamPlugins.enabled"]
          }
        ]
      }
    ]
  }
}
